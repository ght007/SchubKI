 "combination_caveats": [
  {
   "text": "Different methods must sample the same spot, ideally simultaneously, for heterogeneous or fast-changing samples.",
   "source": "S01",
   "page": 8
  },
  {
   "text": "Acquisition rates differ; data must be synchronised to a common time step.",
   "source": "S01",
   "page": 8
  },
  {
   "text": "Variables of different methods are not equivalent; data fusion algorithms are needed.",
   "source": "S01",
   "page": 9
