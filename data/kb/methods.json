    "cuvette"
   ],
   "compatible_fibers": [
    "UV_SILICA"
   ],
   "typical_samples": [
    "clear liquids",
    "high optical density liquids (UV-ATR)",
    "cell suspensions (turbidity)"
   ],
   "strengths": [
    {
     "text": "Very high sensitivity, especially in the UV.",
     "source": "S01",
     "page": 5
    },
    {
     "text": "Low-cost, robust tool for biomass trends: suspension turbidity correlates with cell density.",
     "source": "S01",
     "page": 16
    },
    {
     "text": "Transmission/transflection for clear liquids; UV-ATR for opaque, turbid or highly concentrated media.",
     "source": "S01",
     "page": 16
    }
   ],
   "limitations": [
    {
     "text": "Strong overlap of spectral signals; chemometrics needed for mixtures.",
     "source": "S01",
     "page": 5
    },
    {
     "text": "Low selectivity rating.",
     "source": "S01",
     "page": 6
    }
   ],
   "preconditions": [
    "A defined absorbing species or a justified optical indicator.",
    "Turbidity / optical density is not a direct count of viable cells."
   ]
  },
