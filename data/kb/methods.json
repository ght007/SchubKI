 "methods": [
  {
   "id": "NIR",
   "name": "NIR spectroscopy",
   "nominal_range": {
    "label": "780-2500 nm",
    "um": [
     0.78,
     2.5
    ],
    "source": "S01",
    "page": 10,
    "note": "Nominal method range, not the usable range of a specific instrument, fiber or probe."
   },
   "geometries": [
    "diffuse reflection",
    "transmission",
    "transflection"
   ],
   "compatible_fibers": [
    "VISNIR_SILICA"
   ],
   "typical_samples": [
    "powders",
    "scattering media",
    "opaque dairy products",
    "clear or semi-transparent liquids (transmission)"
   ],
   "strengths": [
    {
     "text": "Most common online analysis method performed with fiber optic probes.",
     "source": "S01",
     "page": 10
    },
    {
     "text": "Large penetration depth (up to several millimetres) and standard glass optics make it suited to online and remote fiber measurements.",
     "source": "S01",
     "page": 5
    },
    {
     "text": "Diffuse reflectance allows measurement of scattering samples, including without direct contact.",
     "source": "S01",
     "page": 10
    },
    {
     "text": "Used for blend potency in a tablet press feed frame (with Raman).",
     "source": "S01",
     "page": 15
    },
    {
     "text": "Reflection for opaque or concentrated dairy products; transmission for transparent liquids such as whey.",
     "source": "S01",
     "page": 17
    }
   ],
   "limitations": [
    {
     "text": "Broad, overlapping bands require chemometrics.",
     "source": "S01",
     "page": 10
    },
    {
     "text": "May lack sensitivity for trace compounds below 0.1 percent.",
     "source": "S01",
     "page": 16
    },
    {
     "text": "Reflection is sensitive to surface characteristics and fat globule size.",
     "source": "S01",
     "page": 17
    },
    {
     "text": "Transmission fails when the product becomes too thick or fat-rich.",
     "source": "S01",
     "page": 18
    }
   ],
   "preconditions": [
    "A matrix-specific calibration against independent reference values is needed."
   ]
  },
  {
   "id": "MIR",
   "name": "Mid-IR spectroscopy (ATR fiber probe)",
   "nominal_range": {
    "label": "4000-400 cm-1 (2.5-25 um)",
    "um": [
     2.5,
     25.0
    ],
    "source": "S01",
    "page": 9,
    "note": "With fiber probes the usable range is limited by the fiber (CIR about 1.1-6.5 um, PIR about 3-17 um) and by the ATR crystal."
   },
   "geometries": [
    "ATR",
    "transflection",
    "cuvette",
    "sample layer",
    "diffuse reflection"
   ],
   "compatible_fibers": [
    "CIR",
    "PIR"
   ],
   "typical_samples": [
    "liquids",
    "pastes",
    "soft solids",
    "biological tissue (ATR)",
    "hot polymer melt (diamond ATR)"
   ],
   "strengths": [
    {
     "text": "One of the most informative methods; well-defined absorption peaks and high sensitivity.",
     "source": "S01",
     "page": 9
    },
    {
     "text": "ATR fiber probes analyse liquids and elastic solids at a distance from the spectrometer, without sampling.",
     "source": "S01",
     "page": 10
    },
    {
     "text": "Complementary to Raman.",
     "source": "S01",
     "page": 11
    },
    {
     "text": "Lab spectra of water in petroleum with ZrO2 / diamond ATR probes.",
     "source": "S02",
     "page": 13
    },
    {
     "text": "API in hot polymer measured with a diamond cone ATR probe and PIR-fiber FTIR.",
     "source": "S02",
     "page": 14
    }
   ],
   "limitations": [
    {
     "text": "Strong absorption limits transmission to very thin samples (usually below 50 um); ATR is used instead.",
     "source": "S01",
     "page": 5
    },
    {
     "text": "ATR needs tight contact with the probe head; suited to liquids and soft solids.",
     "source": "S04",
     "page": 4
    },
    {
     "text": "Water absorbs strongly in the IR compared with Raman.",
     "source": "S01",
     "page": 16
    },
    {
     "text": "Silica fibers do not transmit the MIR; chalcogenide or polycrystalline fibers are needed.",
     "source": "S02",
     "page": 6
    }
   ],
   "preconditions": [
    "IR fiber (CIR or PIR) and an ATR crystal compatible with the medium.",
    "Contact, fouling and cleaning must be assessed."
   ]
  },
  {
   "id": "RAMAN",
   "name": "Raman spectroscopy",
   "nominal_range": {
    "label": "Raman shift in cm-1; excitation laser in nm, stated separately (for example 785 nm)",
    "um": [
     0.4,
     1.1
    ],
    "source": "S01",
    "page": 11,
    "note": "Signals are recorded in the visible / short-wave NIR (about 400-1100 nm detector region). Excitation examples: 785 nm (S01 p.15), 680 nm and 785 nm (S02 p.16)."
   },
   "geometries": [
    "Raman probe",
    "cuvette 90 deg"
   ],
   "compatible_fibers": [
    "UV_SILICA",
    "VISNIR_SILICA"
   ],
   "typical_samples": [
    "liquids",
    "powders",
    "solids",
    "aqueous bioprocess media"
   ],
   "strengths": [
    {
     "text": "Well suited to aqueous media: low water absorbance compared with infrared methods.",
     "source": "S01",
     "page": 16
    },
    {
     "text": "Molecular fingerprint for metabolites such as glucose, acetate or lactate.",
     "source": "S01",
     "page": 16
    },
    {
     "text": "Signal is linear with concentration over a wide range; usable for calibration models.",
     "source": "S01",
     "page": 12
    },
    {
     "text": "Captures the molecular backbone and symmetric non-polar groups, complementary to NIR.",
     "source": "S01",
     "page": 15
    }
   ],
   "limitations": [
    {
     "text": "Raman signals are several orders of magnitude weaker than IR absorption.",
     "source": "S01",
     "page": 11
    },
    {
     "text": "Fluorescence (luminescence) of many organic compounds can overlay the Raman bands.",
     "source": "S01",
     "page": 11
    },
    {
     "text": "Requires special probes and filters; high cost rating.",
     "source": "S01",
     "page": 6
    }
   ],
   "preconditions": [
    "Check fluorescence background on real samples.",
    "State laser excitation and Raman shift range separately."
   ]
  },
  {
