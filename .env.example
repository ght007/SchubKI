# Copy to .env and fill in
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model roles (check with: python scripts/check_groq.py)
MODEL_FAST=openai/gpt-oss-20b
MODEL_MAIN=openai/gpt-oss-120b
COUNCIL_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# 1 = no API calls: every stage uses its rule-based fallback (offline demo / tests)
LLM_MOCK=0
# 1 = cache LLM replies in SQLite (re-runs cost nothing)
LLM_CACHE=1
# Free tier: keep each prompt small
MAX_EVIDENCE_TOKENS=2500
LLM_MAX_RETRIES=8

EMBED_MODEL=BAAI/bge-small-en-v1.5
# set to "hashing" to skip the embedding-model download (offline)
EMBED_BACKEND=
DB_PATH=data/cache/afs.db
RAW_DIR=data/raw
KB_DIR=data/kb

# Accounts (optional login). Google sign-in needs only the public OAuth client id (type "Web application",
# Authorized JavaScript origins: http://localhost:8000 and the hosted URL). Never put the client secret here.
GOOGLE_CLIENT_ID=
SESSION_DAYS=30
# 1 = login required for the assistant at /app (/ opens /login). 0 = open guest app as before (demo fallback).
AUTH_REQUIRED=1
# Plans: Basic $10/month (General view), Pro $30/month (General + Expert). Payments are not connected yet:
# demo = the plan buttons switch the plan at once, no payment taken; off = the buttons say "coming soon".
BILLING_MODE=demo
